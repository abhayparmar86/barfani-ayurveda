PORT=3000
NODE_ENV=development
# Public address of the site (used for sitemap, canonical links and social previews)
SITE_URL=http://localhost:3000
# Long random string. Required in production.
SESSION_SECRET=
# Set to true only when the site is served over HTTPS behind HTTPS-terminating proxy
FORCE_HTTPS=false

# Turso database (required on Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob read/write token (required on Vercel; review images)
BLOB_READ_WRITE_TOKEN=

DOCTOR_NAME=Dr. R.V. Parmar
CO_DOCTOR_NAME=Dr. Poorti R. Parmar
INSTAGRAM=barfani_ayurveda
# Consultation requests and orders are emailed here
DOCTOR_EMAIL=barfaniayurveda@gmail.com
# Country code + number, digits only
WHATSAPP_NUMBER=919537320355

# Gmail: use an App Password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: set this to the same address as SMTP_USER
SMTP_FROM=

# Admin page at /admin (orders, reviews, consultations). Leave blank to disable.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Online payments with Razorpay. Leave empty to hide the online option.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Razorpay Dashboard > Webhooks > URL https://YOUR-DOMAIN/pay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Optional Google Analytics 4 measurement ID, example G-XXXXXXXXXX
GA_MEASUREMENT_ID=

REVIEWS_AUTO_APPROVE=true
OFFER_ENABLED=true
OFFER_UNTIL=Bhai Dooj
