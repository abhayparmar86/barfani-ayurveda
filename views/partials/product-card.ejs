<article class="card">
  <div class="card-media">
    <a href="/product/<%= p.slug %>" class="card-img" aria-label="<%= p.name %>">
      <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.svg'">
    </a>
    <% if (p.offer_eligible && config.offer.enabled) { %><span class="tag">Diwali offer</span><% } %>
    <form method="post" action="/wishlist/toggle/<%= p.id %>" class="wish">
      <button class="<%= wishIds.has(p.id) ? 'active' : '' %>" aria-label="Toggle wishlist"><%- include('icon', { name: 'heart', size: 18 }) %></button>
    </form>
  </div>
  <div class="card-body">
    <span class="cat"><%= p.category %></span>
    <h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
    <% if (p.review_count) { %>
      <a class="card-rating" href="/product/<%= p.slug %>#reviews"><span class="stars">★</span> <%= Number(p.avg_rating).toFixed(1) %> <span class="muted">(<%= p.review_count %>)</span></a>
    <% } %>
    <p class="benefit"><%= filled(p.benefit, 'Details coming soon.') %></p>
    <p class="price"><%= inr(p.price) %> <small><%= p.size %></small></p>
    <form method="post" action="/cart/add/<%= p.id %>" class="card-actions" data-cart-form>
      <%- include('qty-stepper') %>
      <button class="btn">Add to Cart</button>
    </form>
    <div class="card-links">
      <a href="/product/<%= p.slug %>">View details</a>
      <a target="_blank" rel="noopener" href="<%= wa('Namaste, I would like to order ' + p.name + ' (' + p.size + ') from Barfani Ayurveda.') %>">Order on WhatsApp</a>
    </div>
  </div>
</article>
